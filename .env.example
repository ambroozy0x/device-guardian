# Device Guardian - Local Configuration
# Copy this file to .env and fill in your personal values.
# NEVER commit your real .env file to version control.

# Telegram Bot API Configuration (Obtained via @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram User / Chat ID (Obtained via @userinfobot or Telegram API)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Geolocation API Endpoint (Returns JSON with IP, city, region, country, latitude, longitude)
# Defaults to https://ipapi.co/json/ (free tier for personal use, no API key required)
LOCATION_API_URL=https://ipapi.co/json/

# Camera Device Index (0 is typically the primary built-in webcam)
CAMERA_INDEX=0

# Network Request Timeout in Seconds
REQUEST_TIMEOUT_SECONDS=10

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# --- Phase 3: Detection Triggers & Offline Voice Warning ---
# Number of failed authentication attempts required to trigger an alert
AUTH_FAILURE_THRESHOLD=3

# Sliding time window in seconds to accumulate failed authentication attempts
AUTH_FAILURE_WINDOW_SECONDS=60

# Minimum seconds between consecutive authentication alerts to prevent alert storms
AUTH_ALERT_COOLDOWN_SECONDS=300

# Offline text-to-speech voice warning on the local machine (true/false)
VOICE_WARNING_ENABLED=true

# Spoken warning text synthesized locally
VOICE_WARNING_TEXT=Warning. Multiple failed authentication attempts have been detected on this device.

# Minimum seconds between spoken voice warnings
VOICE_WARNING_COOLDOWN_SECONDS=300

# --- Phase 4: Smart Filtering & Environmental Triggers ---
# Enable deterministic smart filtering engine (true/false)
SMART_FILTERING_ENABLED=true

# Comma-separated list of trusted local usernames whose authentication events are benignly filtered
DEVICE_GUARDIAN_TRUSTED_USERS=

# Comma-separated list of trusted network identifiers or subnet tags
DEVICE_GUARDIAN_TRUSTED_NETWORKS=

# Comma-separated list of trusted authentication types (e.g. local)
DEVICE_GUARDIAN_TRUSTED_AUTH_TYPES=

# Enable environmental state tracking (device lock/unlock, network state) (true/false)
ENVIRONMENTAL_TRIGGERS_ENABLED=true

# Enable network context awareness (true/false)
NETWORK_CONTEXT_ENABLED=true

# Enable device lock/workstation state awareness (true/false)
DEVICE_STATE_CONTEXT_ENABLED=true

# Require positive environmental context change to trigger alerts (true/false, default: false)
REQUIRE_CONTEXT_FOR_ALERT=false

# Camera/Location/Telegram Safety Gates (true/false, default: true)
CAMERA_ALERT_ENABLED=true
LOCATION_ALERT_ENABLED=true
TELEGRAM_ALERT_ENABLED=true

# --- Phase 5: Packaging, Background Services & System Tray Integration ---
# Enable background daemon execution mode (true/false)
BACKGROUND_MODE_ENABLED=false

# Enable system tray icon and status menu (true/false)
TRAY_ENABLED=true

# Automatically launch Device Guardian at user login / system startup (true/false)
START_WITH_SYSTEM=false

# Enforce local single-instance lock to prevent duplicate processes (true/false)
SINGLE_INSTANCE_ENABLED=true

# Enable bounded auto-restart recovery on unexpected background worker failures (true/false)
AUTO_RESTART_ENABLED=true

# Maximum number of automatic recovery restarts before transitioning to FAILED state
MAX_RESTART_ATTEMPTS=3

# Delay in seconds between recovery restart attempts
RESTART_BACKOFF_SECONDS=2.0

